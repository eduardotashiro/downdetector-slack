{
    "display_information": {
        "name": "Down Detector",
        "description": "Monitoramento de problemas e quedas de serviços em tempo real",
        "background_color": "#ff0000"
    },
    "features": {
        "bot_user": {
            "display_name": "Down Detector",
            "always_online": true
        }
    },
    "oauth_config": {
        "scopes": {
            "bot": [
                "channels:history",
                "channels:read",
                "chat:write",
                "groups:history"
            ]
        }
    },
    "settings": {
        "org_deploy_enabled": false,
        "socket_mode_enabled": false,
        "token_rotation_enabled": false
    }
}