{
  "name": "downdetector-slack",
  "version": "2.0.0",
  "description": "Monitor Downdetector | Slack",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npx tsx watch ./src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "postinstall": "npx camoufox-js fetch",
    "test:alert": "npx tsx src/scripts/testAlert.ts",
    "test:watch": "vitest",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "Eduardo Tashiro",
  "license": "MIT",
  "dependencies": {
    "@slack/bolt": "^4.6.0",
    "camoufox-js": "^0.12.0",
    "dotenv": "^17.4.2",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "ngrok": "^5.0.0-beta.2",
    "playwright-core": "^1.60.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
